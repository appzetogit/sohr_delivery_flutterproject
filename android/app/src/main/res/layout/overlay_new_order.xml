<?xml version="1.0" encoding="utf-8"?>
<!--
  The incoming-order card, drawn as a native WindowManager overlay.

  Native, not Flutter, on purpose. The previous implementation rendered this in a
  second Flutter engine and had to hand it the order across an isolate boundary
  (SharedPreferences + a plugin message channel); that handoff arrived empty on
  the target device every time — "key empty after 30 reads, 0 direct messages" —
  so the card never had anything to show. Here the values are set straight from
  the FCM RemoteMessage in Kotlin, so there is no boundary left to fail.

  Height is why this is an overlay rather than a custom notification: Android
  caps notification layouts at roughly 256dp and this card is well past 700dp.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlay_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="10dp"
            android:paddingTop="31dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_overlay_card"
                android:elevation="14dp"
                android:orientation="vertical">

                <!-- ─────────────────────────── header ─────────────────────── -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_overlay_header"
                    android:orientation="vertical"
                    android:paddingHorizontal="14dp"
                    android:paddingTop="36dp"
                    android:paddingBottom="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/brand_icon"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_overlay_brand"
                            android:contentDescription="Appzeto"
                            android:padding="5dp"
                            android:src="@mipmap/ic_launcher" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="New Order Received!"
                                android:textColor="#FFFFFFFF"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/headline"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:textColor="#FFFFFFFF"
                                android:textSize="12sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="Accept before the time runs out"
                                android:textColor="#CCFFFFFF"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <!-- Hidden unless artwork is present; see bindRider(). -->
                        <ImageView
                            android:id="@+id/rider_art"
                            android:layout_width="70dp"
                            android:layout_height="54dp"
                            android:contentDescription="@null"
                            android:scaleType="fitCenter"
                            android:visibility="gone" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/countdown"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_overlay_countdown"
                        android:gravity="center"
                        android:paddingHorizontal="18dp"
                        android:paddingVertical="8dp"
                        android:textColor="#FF181C2E"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- ──────────────────────── route preview ─────────────────── -->
                <!--
                  Hidden entirely when the push carries no coordinates or the
                  tile fails to load, rather than leaving a grey hole mid-card.
                -->
                <FrameLayout
                    android:id="@+id/map_container"
                    android:layout_width="match_parent"
                    android:layout_height="124dp"
                    android:layout_marginHorizontal="10dp"
                    android:layout_marginTop="10dp"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/route_map"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_overlay_thumb"
                        android:contentDescription="Route from the store to the customer"
                        android:scaleType="centerCrop" />



                    <!--
                      Only the two facts that appear nowhere else on the card.
                      Store and customer had chips here too, but those repeat
                      the rows immediately below and crowded a short tile.
                    -->
                    <TextView
                        android:id="@+id/map_chip_distance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|start"
                        android:layout_margin="10dp"
                        android:background="@drawable/bg_overlay_map_chip"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="8dp"
                        android:textColor="#FF181C2E"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/map_chip_eta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|end"
                        android:layout_margin="10dp"
                        android:background="@drawable/bg_overlay_map_chip"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="8dp"
                        android:textColor="#FF181C2E"
                        android:textSize="12sp" />
                </FrameLayout>

                <!-- ───────────────────────────── rows ─────────────────────── -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="14dp"
                    android:paddingTop="10dp">

                    <!-- pickup -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_overlay_circle"
                            android:backgroundTint="#FFE3D9FF"
                            android:gravity="center"
                            android:text="🏪"
                            android:textSize="16sp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Pickup from"
                                android:textColor="#FF6B7280"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/pickup_name"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:textColor="#FF181C2E"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/pickup_address"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:textColor="#FF9CA3AF"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/pickup_distance"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:textColor="#FF1E8E3E"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="7dp"
                        android:background="#FFF0F1F3" />

                    <!-- drop -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_overlay_circle"
                            android:backgroundTint="#FFE6F4EA"
                            android:gravity="center"
                            android:text="👤"
                            android:textSize="16sp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Deliver to"
                                android:textColor="#FF6B7280"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/drop_name"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:textColor="#FF181C2E"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/drop_address"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:textColor="#FF9CA3AF"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/drop_distance"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:textColor="#FF1E8E3E"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="7dp"
                        android:background="#FFF0F1F3" />

                    <!-- items -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_overlay_circle"
                            android:backgroundTint="#FFFBEFD9"
                            android:gravity="center"
                            android:text="📦"
                            android:textSize="16sp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Items"
                                android:textColor="#FF6B7280"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/items_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="#FF181C2E"
                                android:textSize="15sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/thumbnails"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="7dp"
                        android:background="#FFF0F1F3" />

                    <!-- ──────────────────────── money strip ───────────────── -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_overlay_strip"
                        android:orientation="horizontal"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="10dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="👛  YOUR EARNING"
                                android:textColor="#FF6B7280"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/earning"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textColor="#FF1E8E3E"
                                android:textSize="28sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/earning_breakdown"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:textColor="#FF9CA3AF"
                                android:textSize="11sp"
                                android:visibility="gone" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/payment_chip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:background="@drawable/bg_overlay_chip"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="9dp"
                            android:textColor="#FF1E8E3E"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- ────────────────────────── actions ─────────────────── -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="12dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btn_reject"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_weight="4"
                            android:background="@drawable/bg_overlay_btn_reject"
                            android:gravity="center"
                            android:text="✕   REJECT"
                            android:textColor="#FFE04444"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btn_accept"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_marginStart="12dp"
                            android:layout_weight="6"
                            android:background="@drawable/bg_overlay_btn_accept"
                            android:gravity="center"
                            android:text="✓   ACCEPT ORDER"
                            android:textColor="#FFFFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!--
              Sits outside the card, so it needs its own backing: this floats
              over an arbitrary app, and plain text would be unreadable against
              a light wallpaper.
            -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_overlay_footer"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp"
                android:text="🛡  High priority order  •  We'll notify the customer once you accept."
                android:textColor="#FFFFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Overlaps the card's top edge; countdown ring is drawn directly inside/on the white circular ring around the bell badge -->
        <FrameLayout
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="top|center_horizontal"
            android:elevation="16dp">

            <com.sohr.delivery.CountdownRing
                android:id="@+id/countdown_ring"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <TextView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_overlay_bell"
                android:gravity="center"
                android:text="🔔"
                android:textSize="18sp" />
        </FrameLayout>
    </FrameLayout>
</ScrollView>
